; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bagani: Guardians of the Archipelago"
run/main_scene="uid://c1p3rkja6i332"
config/features=PackedStringArray("4.5", "Mobile")
boot_splash/show_image=false
config/icon="uid://wg0i2spysfm5"

[autoload]

Spawner="*res://scripts/globals/spawner.gd"
UiManager="*res://scripts/globals/ui_manager.gd"

[debug]

shapes/collision/shape_color=Color(1, 1, 1, 0.41960785)

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="LEVEL UP NSTW"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/inspector_tabs/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "blue",
"res://assets/": "yellow",
"res://resources/": "purple",
"res://scenes/": "green",
"res://scripts/": "teal"
}

