; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LEVEL UP NSTW"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://assets/icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/inspector_tabs/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "blue",
"res://assets/": "yellow",
"res://scenes/": "green",
"res://scripts/": "teal"
}

[rendering]

renderer/rendering_method="mobile"
